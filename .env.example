# ── Serverless backend (Lambda / scripts) ────────────────────────────────────
# Set in .env.local for local script use. Production values are in AWS Secrets
# Manager; Lambda env vars come from Terraform outputs.

# S3 bucket for parsed statement JSON objects (from: terraform output statements_bucket_name)
STATEMENTS_BUCKET=

# AWS region for all resources
STORAGE_REGION=ap-southeast-1
AWS_REGION=ap-southeast-1

# Single email address permitted to sign in (also set as terraform var allowed_email)
ALLOWED_EMAIL=

# ── Frontend SPA (build-time public config) ───────────────────────────────────
# These NEXT_PUBLIC_ values are baked into the static export at build time.
# Set matching values in the CI environment before running `pnpm build`.

# API Gateway base URL (from: terraform output api_gateway_base_url)
NEXT_PUBLIC_API_BASE_URL=https://api.cashight.nghuy.link

# Cognito OIDC issuer URL (from: terraform output cognito_issuer)
NEXT_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.ap-southeast-1.amazonaws.com/<user-pool-id>

# Cognito public SPA client ID — no secret (from: terraform output cognito_spa_client_id)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Production app origin (used for PKCE redirect URI validation)
NEXT_PUBLIC_APP_ORIGIN=https://cashight.nghuy.link

# Cost Explorer is release-gated until the production smoke query passes.
# Set to true only after completing docs/runbooks/aws-cost-explorer.md.
NEXT_PUBLIC_ENABLE_AWS_COST_EXPLORER=false

# AWS invoice parsing is release-gated until the privacy and production smoke
# checks in docs/runbooks/aws-invoice-processing.md pass.
NEXT_PUBLIC_ENABLE_AWS_BILLING_INVOICE=false

# ── Local Lambda development (optional) ──────────────────────────────────────
# Only needed when running Lambda handlers locally. Not used in the static build.
# In production these live in Secrets Manager; Lambda reads them at runtime.

# GEMINI_API_KEY=
# PDF_PASSWORD=
#
# Candidate PDF passwords, one per bank. The keys are labels only — every value
# is tried in turn, because the PDF must be decrypted before its issuing bank
# can be detected. Takes precedence over PDF_PASSWORD, which still works as a
# single password. In production this same JSON is the Secrets Manager value.
# PDF_PASSWORDS={"TPB":"...","VIB":"..."}

# Local-only path to a private AWS invoice for manual parser verification.
# Never set this in CI and never commit the referenced PDF.
# AWS_INVOICE_FIXTURE=test-pdfs/aws-invoice-private.pdf

# ── Local dev stack (`pnpm dev:local`) ───────────────────────────────────────
# Runs the real Lambda handlers in-process against file-backed fake S3 +
# DynamoDB under .local-data/, so PDFs can be uploaded and parsed with no AWS
# account. See docs/local-development.md.
#
# To use it, override the two values above in .env.local:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
#   NEXT_PUBLIC_DEV_AUTH_BYPASS=true
#
# NEXT_PUBLIC_DEV_AUTH_BYPASS makes the SPA skip Cognito sign-in. It is inert
# in production builds (guarded on NODE_ENV !== 'production' and stripped by
# the bundler), so it can never weaken the deployed app.
#
# Optional knobs, all with sane defaults:
# LOCAL_API_PORT=8787              # dev API port
# LOCAL_ALLOWED_ORIGIN=http://localhost:3000
# LOCAL_DATA_DIR=.local-data       # where fake S3/DynamoDB live
# LOCAL_PARSE_DELAY_MS=300         # lag before parsing, to exercise polling
# DEV_AUTH_SUB=local-dev-user      # the subject the local stack acts as
