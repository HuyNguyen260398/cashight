  # ── /summaries ────────────────────────────────────────────────────────────
  # API Gateway REST APIs only support buffered Lambda proxy integrations —
  # there is no response-streaming invoke path here (that's Function URL-only,
  # via InvokeMode = RESPONSE_STREAM). summary-api buffers the full Gemini
  # output and returns it as one text/plain response.

  /summaries:
    post:
      operationId: streamSummary
      summary: Generate a Gemini-generated natural-language spending summary
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: Summary text (text/plain)
        "401":
          description: Unauthorized
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${summary_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsSummaries
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"
