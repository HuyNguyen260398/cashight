openapi: "3.0.1"
info:
  title: cashight-api
  version: "2026-06-29"
  description: >
    Cashight REST API — session capabilities, statements, dashboard, uploads,
    AI summaries, and AWS cost reports.
    All endpoints (except /health) require a Cognito access token with the
    appropriate cashight/read or cashight/write scope.

# SEC-006: CORS is locked to exactly one allowed origin.
x-amazon-apigateway-cors:
  allowOrigins:
    - "https://cashight.nghuy.link"
  allowMethods:
    - GET
    - POST
    - DELETE
    - OPTIONS
  allowHeaders:
    - Content-Type
    - Authorization
    - X-Amz-Date
    - X-Api-Key
    - X-Amz-Security-Token
  maxAge: 300

x-amazon-apigateway-request-validators:
  all:
    validateRequestBody: true
    validateRequestParameters: true

# Inject CORS headers on gateway-level error responses so the browser
# can surface the error message rather than just seeing a CORS failure.
x-amazon-apigateway-gateway-responses:
  UNAUTHORIZED:
    statusCode: 401
    responseParameters:
      gatewayresponse.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
  ACCESS_DENIED:
    statusCode: 403
    responseParameters:
      gatewayresponse.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
  DEFAULT_4XX:
    responseParameters:
      gatewayresponse.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
  DEFAULT_5XX:
    responseParameters:
      gatewayresponse.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"

components:
  schemas:
    CostReportEnvelope:
      type: object
      required: [request]
      additionalProperties: false
      properties:
        request:
          type: object
        refresh:
          type: boolean
    CostDimensionRequest:
      type: object
      required: [type]
      properties:
        type:
          type: string
    SavedCostReportInput:
      type: object
      required: [name, request]
      additionalProperties: false
      properties:
        reportId:
          type: string
          format: uuid
        name:
          type: string
          minLength: 1
          maxLength: 80
        request:
          type: object
  securitySchemes:
    CognitoAuth:
      type: apiKey
      name: Authorization
      in: header
      x-amazon-apigateway-authtype: cognito_user_pools
      x-amazon-apigateway-authorizer:
        type: cognito_user_pools
        providerARNs:
          - "${user_pool_arn}"
        identitySource: method.request.header.Authorization

paths:

  # ── /health (no auth — used by load balancer / uptime checks) ───────────────

  /health:
    get:
      operationId: getHealth
      summary: Health check
      responses:
        "200":
          description: API is healthy
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
            responseTemplates:
              application/json: '{"status":"ok"}'

  # ── /session/capabilities ─────────────────────────────────────────────────

  /session/capabilities:
    get:
      operationId: getSessionCapabilities
      summary: Get server-derived capabilities for the authenticated session
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: SessionCapabilities JSON
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${session_capabilities_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsSessionCapabilities
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'GET,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  # ── /aws/cost-explorer/* ──────────────────────────────────────────────────

  /aws/cost-explorer/query:
    post:
      operationId: queryCostExplorer
      summary: Run or retrieve a complete validated Cost Explorer report
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CostReportEnvelope"
      responses:
        "200":
          description: Complete normalized Cost Explorer report
        "400":
          description: Invalid cost query
        "403":
          description: Cognito reauthentication or AWS access required
        "503":
          description: Query busy or throttled
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsCostExplorerQuery
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/comparisons:
    post:
      operationId: compareCostExplorerPeriods
      summary: Compare two validated Cost Explorer periods
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CostReportEnvelope"
      responses:
        "200":
          description: Normalized cost comparison and drivers
        "400":
          description: Invalid cost query
        "403":
          description: Forbidden
        "503":
          description: AWS query unavailable
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsCostExplorerComparisons
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/dimensions:
    post:
      operationId: listCostExplorerDimensions
      summary: Search paginated Cost Explorer values or list billing views
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CostDimensionRequest"
      responses:
        "200":
          description: Paginated dimension values or billing views
        "400":
          description: Invalid dimension query
        "403":
          description: Forbidden
        "503":
          description: AWS query unavailable
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsCostExplorerDimensions
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/forecast:
    post:
      operationId: forecastCostExplorer
      summary: Forecast a supported validated Cost Explorer report
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CostReportEnvelope"
      responses:
        "200":
          description: Normalized forecast
        "400":
          description: Invalid forecast query
        "403":
          description: Forbidden
        "503":
          description: AWS query unavailable
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsCostExplorerForecast
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/export:
    post:
      operationId: exportCostExplorerCsv
      summary: Create a private short-lived CSV export for the active report
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CostReportEnvelope"
      responses:
        "200":
          description: Five-minute private download URL
        "400":
          description: Invalid export query
        "403":
          description: Forbidden
        "503":
          description: Export unavailable
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsCostExplorerExport
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/reports:
    get:
      operationId: listSavedCostExplorerReports
      summary: List saved Cost Explorer report definitions
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: Saved report definitions
        "403":
          description: Forbidden
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    post:
      operationId: saveCostExplorerReport
      summary: Create, replace, or rename a saved Cost Explorer report
      security:
        - CognitoAuth: ["cashight/write"]
      x-amazon-apigateway-request-validator: all
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SavedCostReportInput"
      responses:
        "201":
          description: Saved report definition
        "400":
          description: Invalid report definition
        "403":
          description: Forbidden
        "409":
          description: Duplicate name or write conflict
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsSavedCostExplorerReports
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'GET,POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /aws/cost-explorer/reports/{reportId}:
    delete:
      operationId: deleteSavedCostExplorerReport
      summary: Delete an owned saved Cost Explorer report
      security:
        - CognitoAuth: ["cashight/write"]
      x-amazon-apigateway-request-validator: all
      parameters:
        - name: reportId
          in: path
          required: true
          schema:
            type: string
            format: uuid
      responses:
        "200":
          description: Saved report deleted
        "400":
          description: Invalid report identifier
        "403":
          description: Forbidden
        "404":
          description: Saved report not found
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${cost_explorer_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsSavedCostExplorerReport
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'DELETE,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  # ── /statements ───────────────────────────────────────────────────────────

  /statements:
    get:
      operationId: listStatements
      summary: List all statements for the authenticated user
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: List of statement metadata
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${statements_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsStatements
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'GET,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /statements/{statementId}:
    get:
      operationId: getStatement
      summary: Get a single statement by ID
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      parameters:
        - name: statementId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Statement JSON
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
        "404":
          description: Not found
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${statements_api_arn}/invocations"
        passthroughBehavior: when_no_match
    delete:
      operationId: deleteStatement
      summary: Delete a statement
      security:
        - CognitoAuth: ["cashight/write"]
      x-amazon-apigateway-request-validator: all
      parameters:
        - name: statementId
          in: path
          required: true
          schema:
            type: string
      responses:
        "204":
          description: Statement deleted
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
        "404":
          description: Not found
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${statements_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsStatement
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'GET,DELETE,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  # ── /dashboard ────────────────────────────────────────────────────────────

  /dashboard:
    get:
      operationId: getDashboard
      summary: Get aggregated dashboard data for a period
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: AggregatedView JSON
        "401":
          description: Unauthorized
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${dashboard_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsDashboard
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'GET,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  # ── /uploads ──────────────────────────────────────────────────────────────

  /uploads:
    post:
      operationId: createUpload
      summary: Initiate a PDF statement upload (returns a pre-signed S3 URL)
      security:
        - CognitoAuth: ["cashight/write"]
      x-amazon-apigateway-request-validator: all
      responses:
        "200":
          description: Upload job created with pre-signed URL
        "401":
          description: Unauthorized
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${uploads_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsUploads
      summary: CORS preflight
      responses:
        "200":
          description: CORS preflight response
          headers:
            Access-Control-Allow-Origin:
              schema:
                type: string
            Access-Control-Allow-Methods:
              schema:
                type: string
            Access-Control-Allow-Headers:
              schema:
                type: string
      x-amazon-apigateway-integration:
        type: MOCK
        requestTemplates:
          application/json: '{"statusCode": 200}'
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Access-Control-Allow-Origin: "'https://cashight.nghuy.link'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Headers: "'Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token'"

  /uploads/{jobId}:
    get:
      operationId: getUploadStatus
      summary: Poll the status of an upload/parse job
      security:
        - CognitoAuth: ["cashight/read"]
      x-amazon-apigateway-request-validator: all
      parameters:
        - name: jobId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Job status
        "401":
          description: Unauthorized
        "404":
          description: Job not found
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "arn:aws:apigateway:${region}:lambda:path/2015-03-31/functions/${upload_status_api_arn}/invocations"
        passthroughBehavior: when_no_match
    options:
      operationId: optionsUploadStatus
      summary: CORS preflight
      responses:
