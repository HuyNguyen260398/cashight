# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build
/dist/

# misc
.DS_Store
.superpowers/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local
.env*.local

# vercel
.vercel

# local PDF fixtures (never commit real statements)
/test-pdfs/
/test-pdfs/aws-invoices/

# Statement PDFs are real financial documents and carry a full PAN, so they are
# ignored wherever they land — not just under /test-pdfs/. No PDF has ever been
# tracked here; if one ever genuinely belongs in the repo, use `git add -f`.
*.pdf

# local dev stack data (fake S3 objects + fake DynamoDB table — real statements)
/.local-data/

# private migration snapshots (contain storage inventory metadata)
/.migration-private/

# typescript
*.tsbuildinfo
next-env.d.ts
